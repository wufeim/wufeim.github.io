<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% comment %} On the homepage (limit=true), only show news from the past year. {% endcomment %}
    {% assign cutoff = site.time | date: '%s' | minus: 31536000 %}
    <ul class="news-list">
      {% for item in news %}
        {% assign item_time = item.date | date: '%s' | plus: 0 %}
        {% if include.limit and item_time < cutoff %}
          {% continue %}
        {% endif %}
        <li>
          <b>{{ item.date | date: '%b %Y' }}</b>&nbsp;
          {% if item.inline %}
            {{ item.content | remove: '<p>' | remove: '</p>' | strip | emojify }}
          {% else %}
            <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
